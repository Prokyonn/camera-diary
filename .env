# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base of absolute links, e.g. in MCP results.
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

# Tailscale Serve and Docker forward from private addresses; trust their X-Forwarded-* headers.
TRUSTED_PROXIES=private_ranges

# Bearer token for the MCP server (/mcp). Empty: open, for the demo or a server only reachable in a private network.
MCP_TOKEN=

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/events.sqlite"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

SEARCH_ENGINE_DSN="loupe://%kernel.project_dir%/var/data/search"

# Time zone for display, day boundaries and the nightly maintenance.
APP_TIMEZONE=UTC

# Bearer token for POST /api/events; the hook is closed while it is empty. Put the real one into .env.local.
INGEST_TOKEN=

# AI provider: gemini, vertexai, ollama, claude_code (Claude subscription via the claude CLI) or codex (ChatGPT
# subscription via the codex CLI). AI_MODEL examples: gemini-3.8-flash, gemini-2.5-flash, qwen2.5vl:7b, sonnet. A pinned
# version rather than an alias like gemini-flash-latest keeps the answers comparable over time.
AI_PLATFORM=gemini
AI_MODEL=gemini-3.8-flash

# Settings of this installation: AI limits and context, vocabularies, timings. Defaults apply while the file is
# missing; see camera-diary.example.yaml and bin/console app:settings.
CAMERA_DIARY_CONFIG="%kernel.project_dir%/var/data/camera-diary.yaml"

###> symfony/ai-gemini-platform ###
GEMINI_API_KEY=
###< symfony/ai-gemini-platform ###

###> symfony/ai-vertex-ai-platform ###
# API key of a Google Cloud project with the Vertex AI API enabled; AI_MODEL e.g. gemini-2.5-flash
VERTEX_AI_API_KEY=
###< symfony/ai-vertex-ai-platform ###

###> symfony/ai-ollama-platform ###
OLLAMA_HOST_URL=http://127.0.0.1:11434
###< symfony/ai-ollama-platform ###

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FRAME_WIDTH=1920

###> camera-diary/home-assistant ###
# Optional add-on; idle while HOME_ASSISTANT_CONFIG points to no file. See addons/home-assistant/README.md.
HOME_ASSISTANT_CONFIG="%kernel.project_dir%/var/data/home-assistant.yaml"
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Continuous recordings, e.g. Synology Surveillance Station: <RECORDINGS_DIR>/<recording_folder>/<YYYYMMDD><AM|PM>/*.mp4
RECORDINGS_DIR=
###< camera-diary/home-assistant ###
