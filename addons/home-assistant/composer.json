{
    "name": "camera-diary/home-assistant",
    "description": "Camera diary add-on: imports detections and context signals from Home Assistant and cuts frames from continuous recordings.",
    "type": "symfony-bundle",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": ">=8.4",
        "symfony/config": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "autoload": {
        "psr-4": {
            "CameraDiary\\HomeAssistant\\": "src/",
            "CameraDiary\\HomeAssistant\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CameraDiary\\HomeAssistant\\Tests\\": "tests/"
        }
    }
}
