{% extends 'base.html.twig' %}

{% block title %}{{ event.camera.name }} {{ event.startedAt|date('j M H:i') }} · Camera diary{% endblock %}

{% block body %}
    <p><a href="{{ path('timeline', {day: event.startedAt|date('Y-m-d')}) }}">← {{ event.startedAt|date('l, j F') }}</a></p>
    <h1>
        {{ event.camera.name }},
        <time datetime="{{ event.startedAt|date('c') }}">{{ event.startedAt|date('H:i:s') }}</time>
        {% if event.endedAt != event.startedAt %}to <time datetime="{{ event.endedAt|date('c') }}">{{ event.endedAt|date('H:i:s') }}</time>{% endif %}
    </h1>

    {% if event.framePaths is not empty %}
        <div class="frames">
            {% for path in event.framePaths %}
                <a href="{{ path('event_frame', {id: event.id, index: loop.index0, v: event.startedAt|date('U')}) }}">
                    <img src="{{ path('event_frame', {id: event.id, index: loop.index0, v: event.startedAt|date('U')}) }}" alt="Frame {{ loop.index }} of {{ event.framePaths|length }}" width="{{ event.frameWidth }}" height="{{ event.frameHeight }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
                </a>
            {% endfor %}
        </div>
    {% elseif event.framesRemovedAt %}
        <p class="empty">The frames of this false alarm were removed on {{ event.framesRemovedAt|date('j M Y') }}.</p>
    {% endif %}

    <dl class="facts">
        <dt>Detected</dt>
        <dd>{{ event.detectionTypes is empty ? 'not specified' : event.detectionTypes|map(type => type|term_label('detection_types'))|join(' and ') }}{% if event.detectionCount > 1 %}, {{ event.detectionCount }} times{% endif %}</dd>
        <dt>Source</dt>
        <dd>{{ event.source }}</dd>
        <dt>Status</dt>
        <dd>{{ event.status.value|replace({'_': ' '}) }}{% if event.status.value == 'pending' and event.nextAttemptAt %}, next try {{ event.nextAttemptAt|date('H:i') }}{% endif %}</dd>
        {% if event.summary %}
            <dt>Description</dt>
            <dd>{{ event.summary }}</dd>
            <dt>Verdict</dt>
            <dd>
                {{ event.effectiveVerdict.label }}{% if event.unusual and not event.falseAlarm %}, unusual{% endif %}
                {% if event.falseAlarm and event.falseAlarmCause %}({{ event.falseAlarmCause|term_label('false_alarm_causes') }}){% endif %}
                {% if event.verdictOverride %}<small>set by hand; the AI said {{ event.verdict.label|default('nothing') }}</small>{% endif %}
            </dd>
            <dt>Side</dt>
            <dd>{{ event.side.label }}</dd>
            <dt>Subject</dt>
            <dd>
                {{ subject_label(event) }}
                {% if event.individualOverride %}<small>set by hand; the AI said {{ event.individual ? event.individual|term_label('individuals') : 'nobody we know' }}</small>{% endif %}
            </dd>
        {% endif %}
        {% if hints is not empty %}
            <dt>Hints</dt>
            <dd>
                <ul>
                    {% for hint in hints %}
                        <li>{{ hint }}</li>
                    {% endfor %}
                </ul>
            </dd>
        {% endif %}
    </dl>

    <section aria-labelledby="label-heading">
        <h2 id="label-heading">Correct</h2>
        {{ form_start(form) }}
            {{ form_row(form.label) }}
            {{ form_row(form.verdictOverride) }}
            {% if form.individualOverride is defined %}{{ form_row(form.individualOverride) }}{% endif %}
            <button type="submit">Save</button>
        {{ form_end(form) }}
    </section>

    {% if reference_form %}
        <section aria-labelledby="reference-heading">
            <h2 id="reference-heading">Reference photo</h2>
            <p class="meta">Pick a frame and drag a box around the animal or person; without a box the whole frame is used. The AI compares later events with it (<a href="{{ path('individuals') }}">all reference photos</a>).</p>
            {{ form_start(reference_form, {attr: {class: 'reference-form'}}) }}
                {{ form_row(reference_form.frame) }}
                <div class="crop" data-crop data-frames="{{ event.framePaths|map((path, index) => path('event_frame', {id: event.id, index: index, v: event.startedAt|date('U')}))|json_encode }}">
                    <img src="{{ path('event_frame', {id: event.id, index: 0, v: event.startedAt|date('U')}) }}" alt="The chosen frame; drag a box on it" width="{{ event.frameWidth }}" height="{{ event.frameHeight }}" draggable="false">
                    <div class="crop-box" hidden></div>
                </div>
                {{ form_row(reference_form.individual) }}
                {{ form_widget(reference_form.crop) }}
                <button type="submit">Save reference photo</button>
            {{ form_end(reference_form) }}
        </section>
        <script>
            {
                const area = document.querySelector('[data-crop]');
                const image = area.querySelector('img');
                const box = area.querySelector('.crop-box');
                const input = document.getElementById('{{ reference_form.crop.vars.id }}');
                const frames = JSON.parse(area.dataset.frames);
                let start = null;

                const point = (event) => {
                    const rect = image.getBoundingClientRect();
                    return {
                        x: Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1),
                        y: Math.min(Math.max((event.clientY - rect.top) / rect.height, 0), 1),
                    };
                };
                const show = (from, to) => {
                    const x = Math.min(from.x, to.x), y = Math.min(from.y, to.y);
                    const width = Math.abs(to.x - from.x), height = Math.abs(to.y - from.y);
                    Object.assign(box.style, {left: `${x * 100}%`, top: `${y * 100}%`, width: `${width * 100}%`, height: `${height * 100}%`});
                    box.hidden = false;
                    input.value = width > 0.01 && height > 0.01 ? [x, y, width, height].map((value) => value.toFixed(4)).join(',') : '';
                };
                const reset = () => {
                    box.hidden = true;
                    input.value = '';
                };

                area.addEventListener('pointerdown', (event) => {
                    start = point(event);
                    area.setPointerCapture(event.pointerId);
                });
                area.addEventListener('pointermove', (event) => start && show(start, point(event)));
                area.addEventListener('pointerup', (event) => {
                    if (start) {
                        show(start, point(event));
                        start = null;
                    }
                });
                area.addEventListener('pointercancel', () => {
                    start = null;
                    reset();
                });
                document.querySelectorAll('input[name="{{ reference_form.frame.vars.full_name }}"]').forEach((radio) => radio.addEventListener('change', () => {
                    image.src = frames[Number(radio.value)];
                    reset();
                }));
            }
        </script>
    {% endif %}

    {% if event.describedAt %}
        <p class="meta">Described by {{ event.model }} on {{ event.describedAt|date('j M Y, H:i') }}.</p>
    {% endif %}
{% endblock %}
