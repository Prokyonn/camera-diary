{% extends 'base.html.twig' %}

{% block title %}{{ event.camera.name }} {{ event.startedAt|date('j M H:i') }} · Camera events{% endblock %}

{% block body %}
    <p><a href="{{ path('timeline', {day: event.startedAt|date('Y-m-d')}) }}">← {{ event.startedAt|date('l, j F') }}</a></p>
    <h1>
        {{ event.camera.name }},
        <time datetime="{{ event.startedAt|date('c') }}">{{ event.startedAt|date('H:i:s') }}</time>
        {% if event.endedAt != event.startedAt %}to <time datetime="{{ event.endedAt|date('c') }}">{{ event.endedAt|date('H:i:s') }}</time>{% endif %}
    </h1>

    {% if event.framePaths is not empty %}
        <div class="frames">
            {% for path in event.framePaths %}
                <a href="{{ path('event_frame', {id: event.id, index: loop.index0, v: event.startedAt|date('U')}) }}">
                    <img src="{{ path('event_frame', {id: event.id, index: loop.index0, v: event.startedAt|date('U')}) }}" alt="Frame {{ loop.index }} of {{ event.framePaths|length }}" width="{{ event.frameWidth }}" height="{{ event.frameHeight }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
                </a>
            {% endfor %}
        </div>
    {% elseif event.framesRemovedAt %}
        <p class="empty">The frames of this false alarm were removed on {{ event.framesRemovedAt|date('j M Y') }}.</p>
    {% endif %}

    <dl class="facts">
        <dt>Detected</dt>
        <dd>{{ event.detectionTypes is empty ? 'not specified' : event.detectionTypes|map(type => type.value)|join(' and ') }}{% if event.detectionCount > 1 %}, {{ event.detectionCount }} times{% endif %}</dd>
        <dt>Source</dt>
        <dd>{{ event.source }}</dd>
        <dt>Status</dt>
        <dd>{{ event.status.value|replace({'_': ' '}) }}{% if event.status.value == 'pending' and event.nextAttemptAt %}, next try {{ event.nextAttemptAt|date('H:i') }}{% endif %}</dd>
        {% if event.summary %}
            <dt>Description</dt>
            <dd>{{ event.summary }}</dd>
            <dt>Verdict</dt>
            <dd>
                {{ event.effectiveVerdict.label }}
                {% if event.falseAlarm and event.falseAlarmCause and event.falseAlarmCause.value != 'none' %}({{ event.falseAlarmCause.label }}){% endif %}
                {% if event.verdictOverride %}<small>set by hand; the AI said {{ event.verdict.label|default('nothing') }}</small>{% endif %}
            </dd>
            <dt>Side</dt>
            <dd>{{ event.side.label }}</dd>
            <dt>Subject</dt>
            <dd>{{ event.subject.label }}</dd>
        {% endif %}
        {% if hints is not empty %}
            <dt>Hints</dt>
            <dd>
                <ul>
                    {% for hint in hints %}
                        <li>{{ hint }}</li>
                    {% endfor %}
                </ul>
            </dd>
        {% endif %}
    </dl>

    <section aria-labelledby="label-heading">
        <h2 id="label-heading">Correct</h2>
        {{ form_start(form) }}
            {{ form_row(form.label) }}
            {{ form_row(form.verdictOverride) }}
            <button type="submit">Save</button>
        {{ form_end(form) }}
    </section>

    {% if event.describedAt %}
        <p class="meta">Described by {{ event.model }} on {{ event.describedAt|date('j M Y, H:i') }}.</p>
    {% endif %}
{% endblock %}
