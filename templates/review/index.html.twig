{% extends 'base.html.twig' %}

{% block title %}To check · Camera diary{% endblock %}

{% block body %}
    <h1>To check</h1>
    <p class="meta">The AI was not sure about these. Confirm a right answer here, or open the event to correct it: the AI learns from every correction on that camera.</p>

    {% if events is empty %}
        <p class="empty">Nothing to check.</p>
    {% else %}
        <ol class="cards">
            {% for event in events %}
                <li>
                    {{ include('_event_card.html.twig', {event: event, lazy: loop.index > 3, show_date: true}) }}
                    {{ include('event/_confirm.html.twig', {event: event, return: 'review'}) }}
                </li>
            {% endfor %}
        </ol>
    {% endif %}
{% endblock %}
