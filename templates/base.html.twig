<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
        <title>{% block title %}Camera diary{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('styles.css') }}">
        {% block head %}{% endblock %}
    </head>
    <body>
        <header class="site-header">
            <div class="site-header-inner">
                <span class="brand">Camera diary</span>
                <nav aria-label="Main">
                    <a href="{{ path('timeline') }}"{% if app.current_route == 'timeline' %} aria-current="page"{% endif %}>Timeline</a>
                    <a href="{{ path('ask') }}"{% if app.current_route == 'ask' %} aria-current="page"{% endif %}>Ask</a>
                    {% set to_check = review_count() %}
                    <a href="{{ path('review') }}"{% if app.current_route == 'review' %} aria-current="page"{% endif %}>Check{% if to_check > 0 %} <span class="count">{{ to_check }}</span>{% endif %}</a>
                    <a href="{{ path('insights') }}"{% if app.current_route == 'insights' %} aria-current="page"{% endif %}>Insights</a>
                    <a href="{{ path('individuals') }}"{% if app.current_route == 'individuals' %} aria-current="page"{% endif %}>Known</a>
                </nav>
            </div>
        </header>
        <main>
            {% for message in app.flashes('success') %}
                <p class="flash" role="status">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <p class="flash is-error" role="alert">{{ message }}</p>
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
